# Copy to .env and set your local database password. Never commit .env.
DB_URL=jdbc:postgresql://127.0.0.1:5432/growthhub
DB_USER=growthhub
DB_PASSWORD=replace-with-local-password
APP_TIMEZONE=Asia/Shanghai
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Optional future integration; leave blank until M2.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
