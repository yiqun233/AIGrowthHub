# Copy to .env and set your local database password. Never commit .env.
DB_URL=jdbc:postgresql://127.0.0.1:5432/growthhub
DB_USER=growthhub
DB_PASSWORD=replace-with-local-password
APP_TIMEZONE=Asia/Shanghai
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Optional AI integration; leave credentials blank to use manual workflows.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional server-side provider configuration. Set a model your account can access.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
AI_TIMEOUT_SECONDS=90
AI_DAILY_LIMIT=20

# Mainstream providers: set your account's exact model / endpoint ID.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
ZHIPU_API_KEY=
ZHIPU_MODEL=
MOONSHOT_API_KEY=
MOONSHOT_MODEL=
DOUBAO_API_KEY=
DOUBAO_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
# Every provider also supports PREFIX_BASE_URL / PREFIX_OUTPUT_MODE.
# Output modes: TEXT, JSON_OBJECT, JSON_SCHEMA (provider/model dependent).
# OpenAI-compatible providers support PREFIX_TOKEN_PARAMETER:
# max_tokens or max_completion_tokens. See docs/model-providers.md.

# Local loopback may stay unauthenticated; all remote/container listeners require login.
AUTH_ENABLED=false
AUTH_USERNAME=growthhub
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m
FEED_AUTO_REFRESH=false
FEED_REFRESH_MS=900000
RSSHUB_URL=https://rsshub.app
# Optional; generate a private 32-byte key with: openssl rand -base64 32
FEED_COOKIE_ENCRYPTION_KEY=
