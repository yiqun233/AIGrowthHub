# Copy outside Git to infra/.env.production and chmod 600.
PG_ADMIN_PASSWORD=replace-with-private-admin-password
DB_PASSWORD=replace-with-private-database-password
AUTH_USERNAME=growthhub
AUTH_PASSWORD=replace-with-private-login-password
AUTH_PASSWORD_HASH=
APP_DOMAIN=localhost
ACME_EMAIL=replace-with-your-email@example.com
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18085
HTTPS_PORT=18443
AI_DAILY_LIMIT=20
AI_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: public.ecr.aws/docker/library is the Docker official mirror on AWS ECR.
BASE_REGISTRY=docker.io/library
